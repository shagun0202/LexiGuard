# Gemini API Authentication
GEMINI_API_KEY=your_gemini_api_key_here

# Model Fallback Chains (Comma-separated, order of priority)
GEMINI_MODEL_CHAIN_LIGHT=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_MODEL_CHAIN_HEAVY=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Performance & Reliability Knobs
GEMINI_TIMEOUT_SECONDS=35
GEMINI_MIN_INTERVAL_SECONDS=1.0

# Application Branding & Configuration
APP_NAME=LexiGuard
APP_SUBTITLE=Enterprise AI Legal Document Intelligence & Risk Engine
